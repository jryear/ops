{
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": 2
    },
    "task_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_.:-]{1,160}$"
    },
    "board": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_.:-]{1,160}$"
    },
    "project": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_.:-]{1,160}$"
    },
    "objective": {
      "type": "string",
      "minLength": 1
    },
    "user_journey": {
      "type": "string",
      "minLength": 1
    },
    "role": {
      "enum": [
        "principal",
        "coordinator",
        "implementer",
        "reviewer",
        "diagnostician",
        "integrator"
      ]
    },
    "task_class": {
      "type": "string",
      "minLength": 1
    },
    "route": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_.:-]{1,160}$"
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "worktree": {
          "type": "string",
          "minLength": 1
        },
        "base_revision": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "read_paths": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "write_paths": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 0,
          "uniqueItems": true
        },
        "prohibited_effects": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1,
          "uniqueItems": true
        }
      },
      "required": [
        "worktree",
        "base_revision",
        "read_paths",
        "write_paths",
        "prohibited_effects"
      ]
    },
    "ownership": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "orca_run_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_.:-]{1,160}$"
        },
        "coordinator_handle": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_.:-]{1,160}$"
        },
        "execution_authority_ref": {
          "type": "string",
          "minLength": 1
        },
        "allowed_terminal_handles": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_.:-]{1,160}$"
          },
          "minItems": 0,
          "uniqueItems": true
        }
      },
      "required": [
        "orca_run_id",
        "coordinator_handle",
        "execution_authority_ref",
        "allowed_terminal_handles"
      ]
    },
    "acceptance": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "description": {
            "type": "string",
            "minLength": 1
          },
          "argv": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 1,
            "uniqueItems": true
          },
          "timeout_seconds": {
            "type": "integer",
            "minimum": 1,
            "maximum": 3600
          }
        },
        "required": [
          "description",
          "argv",
          "timeout_seconds"
        ]
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "dependencies": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z0-9_.:-]{1,160}$"
      },
      "minItems": 0,
      "uniqueItems": true
    },
    "source_evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        },
        "required": [
          "path",
          "sha256"
        ]
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "decisions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        },
        "required": [
          "path",
          "sha256"
        ]
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "authorization": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "references": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "path": {
                "type": "string",
                "minLength": 1
              },
              "sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              }
            },
            "required": [
              "path",
              "sha256"
            ]
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "permissions": {
          "const": "yolo",
          "description": "Native worker permission mode: no approval prompts and no native sandbox. Task scope remains binding."
        },
        "network": {
          "type": "boolean",
          "description": "Task authorization for network effects; a task constraint, not an operating-system sandbox guarantee."
        },
        "expires_at": {
          "type": "integer",
          "minimum": 1
        }
      },
      "required": [
        "references",
        "permissions",
        "network",
        "expires_at"
      ]
    },
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "runtime_seconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 14400
        },
        "depth": {
          "type": "integer",
          "minimum": 0,
          "maximum": 3
        },
        "corrections": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1
        },
        "max_attempts": {
          "type": "integer",
          "minimum": 1,
          "maximum": 5
        },
        "progress_seconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 3600
        }
      },
      "required": [
        "runtime_seconds",
        "depth",
        "corrections",
        "max_attempts",
        "progress_seconds"
      ]
    },
    "stop_conditions": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "integration": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "canonical_checkout": {
          "type": "string",
          "minLength": 1
        },
        "canonical_branch": {
          "type": "string",
          "minLength": 1
        },
        "expected_head": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "authority_ref": {
          "type": "string",
          "minLength": 1
        },
        "queue_board": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_.:-]{1,160}$"
        }
      },
      "required": [
        "canonical_checkout",
        "canonical_branch",
        "expected_head",
        "authority_ref",
        "queue_board"
      ]
    }
  },
  "required": [
    "schema_version",
    "task_id",
    "board",
    "project",
    "objective",
    "user_journey",
    "role",
    "task_class",
    "route",
    "scope",
    "ownership",
    "acceptance",
    "dependencies",
    "source_evidence",
    "decisions",
    "authorization",
    "limits",
    "stop_conditions",
    "integration"
  ],
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.ops/schemas/task-packet-v2.json",
  "title": "Ops execution task packet v2"
}
